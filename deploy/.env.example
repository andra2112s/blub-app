# Salin jadi .env lalu isi. File .env JANGAN di-commit.

# Domain Studio (A record harus mengarah ke IP VPS sebelum menjalankan compose)
STUDIO_DOMAIN=studio.domainkamu.com
PUBLIC_URL=https://studio.domainkamu.com

# Origin PWA Mochi yang boleh memanggil Studio (pisahkan dengan koma)
ALLOWED_ORIGINS=https://mochi-kamu.vercel.app

# Google Cloud Console → APIs & Services → Credentials → OAuth client ID (Web application)
GOOGLE_CLIENT_ID=

# Email Google yang boleh membuka https://STUDIO_DOMAIN/admin (pisahkan dengan koma)
# Email di sini juga mendapat kredit UNLIMITED di Studio.
ADMIN_EMAILS=

# OPSIONAL: jalur masuk admin tanpa Google (email + kode, min 8 karakter).
# Ini "pintu belakang" pemilik — pakai kode panjang & acak, jangan dibagi ke pengguna.
# Kosongkan untuk menonaktifkan.
ADMIN_LOGIN_CODE=

# Rahasia penandatangan link media. Buat dengan: openssl rand -hex 32
STUDIO_SECRET=

# Isi teks QRIS statis merchant (scan QR merchant dengan aplikasi pemindai QR, salin teks yang diawali 000201...)
QRIS_STATIC=

# Batas waktu pembayaran (menit) & jumlah video yang diproses bersamaan
ORDER_TTL_MIN=30
MAX_CONCURRENT_JOBS=2
