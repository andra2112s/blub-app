{
  "version": 2,
  "rewrites": [
    { "source": "/manifest.json", "destination": "/api/manifest" },
    { "source": "/api/(.*)", "destination": "/api/chat" }
  ],
  "headers": [
    {
      "source": "/api/(.*)",
      "headers": [
        { "key": "Cache-Control", "value": "no-store" }
      ]
    }
  ]
}
