# ── Key AI Mochi (server-side) ──
# Salin file ini jadi ".env" lalu isi key-nya. File .env TIDAK ikut ke git
# (aman) dan frontend tidak perlu isi apa-apa — Mochi otomatis pakai rantai ini.
#
# Di Vercel (deploy): isi key lewat dashboard → Project → Settings →
# Environment Variables (nama sama persis seperti di bawah).
#
# Rantai prioritas: sumopod → deepseek → groq → pollinations (gratis keyless).
# Isi salah satu saja pun sudah cukup.

# SumoPod — key gratis dari sumopod.com (dipakai server, ada kuota harian FREE_LIMIT)
SUMOPOD_API_KEY=

# DeepSeek — dari platform.deepseek.com (berbayar, murah)
DEEPSEEK_API_KEY=

# Groq — GRATIS & paling cepat, dari console.groq.com/keys (30 req/menit)
GROQ_API_KEY=

# Kuota harian pemakaian server gratis sumopod per IP (opsional)
# FREE_LIMIT=30
